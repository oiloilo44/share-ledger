# =============================================================================
# 개발 단계 .gitignore 설정
# =============================================================================
# 현재는 개발 단계이므로 .env, plan.md, docs 등을 포함합니다.
# 릴리즈 시 새 저장소를 만들 때는 아래 "릴리즈용 설정" 섹션을 참고하세요.

# Virtual environments
.venv*

# Python
__pycache__
*.py[cod]
*.egg-info/
.coverage
htmlcov/
*.coverage
.pytest_cache/

# Node
node_modules/
.pnpm-debug.log
.turbo/

# Build artifacts
/dist/
/.parcel-cache/
frontend/dist/
backend/dist/

# Environment files (개발 단계이므로 .env는 추적, .local만 제외)
.env.local
.env.*.local
backend/.env.local
frontend/.env.local

# IDE (개인 설정만 제외)
.idea/
.vscode/settings.json
.vscode/launch.json
.code/

# Development server logs
.devserver/

# Lighthouse/Chrome DevTools temporary files
undefined:/
lighthouse.*/

# OS files
.DS_Store
Thumbs.db


# =============================================================================
# 릴리즈용 .gitignore 설정 (새 저장소 생성 시 사용)
# =============================================================================
# 새 저장소 생성 시 아래 주석을 해제하여 사용하세요.
# 개발 단계의 모든 ignore 규칙 + 추가 보안/내부 문서 제외
#
# # Virtual environments
# .venv*
#
# # Python
# __pycache__
# *.py[cod]
# *.egg-info/
# .coverage
# htmlcov/
# *.coverage
# .pytest_cache/
#
# # Node
# node_modules/
# .pnpm-debug.log
# .turbo/
#
# # Build artifacts
# /dist/
# /.parcel-cache/
# frontend/dist/
# backend/dist/
#
# # 환경 변수 파일 (보안 - 개발 단계와 다른 점)
# .env
# .env.*
# .env.local
# .env.*.local
# backend/.env
# backend/.env.*
# backend/.env.local
# frontend/.env
# frontend/.env.*
# frontend/.env.local
# !.env.example
# !backend/.env.example
# !frontend/.env.example
#
# # 내부 개발 문서 (보안 - 개발 단계와 다른 점)
# plan.md
# docs/stitch_/
# docs/*-plan.md
# docs/ui-ux-improvement-plan.md
#
# # IDE
# .idea/
# .vscode/
# .code/
#
# # Development server logs
# .devserver/
#
# # Lighthouse/Chrome DevTools temporary files
# undefined:/
# lighthouse.*/
#
# # OS files
# .DS_Store
# Thumbs.db
#
# # 테스트 커버리지 (선택적)
# coverage/
# .nyc_output/
# test-results/
#
# =============================================================================
# 릴리즈 시 포함해야 할 필수 파일 (참고용)
# =============================================================================
# ✅ 소스 코드:
#    - backend/app/
#    - frontend/src/
#    - infra/migrations/
#
# ✅ 설정 파일:
#    - backend/pyproject.toml, uv.lock
#    - frontend/package.json, pnpm-lock.yaml
#    - .python-version, .nvmrc
#    - .pre-commit-config.yaml
#    - .prettierrc, ruff.toml
#
# ✅ Git 설정:
#    - .gitignore (릴리즈용으로 수정)
#    - .husky/pre-commit
#
# ✅ 문서:
#    - README.md (필수)
#
#    선택적 (오픈소스라면 유용, 일반 릴리즈는 불필요):
#    - DEVELOPMENT.md
#    - CLAUDE.md, AGENTS.md
#    - docs/database.md
#    - docs/backend-architecture.md
#    - docs/supabase.md
#    - docs/browser-compatibility.md
#
# ✅ 환경 변수 예제:
#    - backend/.env.example
#    - frontend/.env.example
#
# ❌ 개발 단계와 달리 제외해야 할 것:
#    - .env 파일들 (실제 키 포함) ⚠️ 보안
#    - plan.md (내부 계획)
#    - docs/stitch_/ (디자인 프로토타입)
#    - docs/*-plan.md (개발 계획)
#    - docs/ui-ux-improvement-plan.md
#
# 💡 개발 단계 vs 릴리즈 단계 차이점:
#    개발: .env 포함 (팀 공유), plan.md/docs 포함 (컨텍스트 공유)
#    릴리즈: .env 제외 (보안), 내부 문서 제외 (공개 방지)
