# ShareLedger 기본 환경 변수 예시

# 실행 환경 식별자 (development, staging, production 등)
SHARELEDGER_ENVIRONMENT=development

# Supabase 프로젝트 REST URL (ex: https://your-project.supabase.co)
SHARELEDGER_SUPABASE_URL=https://your-project.supabase.co

# Supabase server key (민감 정보, 절대 커밋 금지)
SHARELEDGER_SUPABASE_SERVER_KEY=dummy-server-key

# 프런트엔드 CORS 허용 Origin 목록 (JSON 배열)
SHARELEDGER_CORS_ORIGINS='["http://localhost:5173"]'
